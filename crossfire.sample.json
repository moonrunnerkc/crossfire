{
  "task": "Find and close memory safety bugs in the target's request parsing path",
  "target": {
    "repoPath": "./fixtures/vulnerable-repo",
    "inScopeDirs": ["src"],
    "buildCommand": "./build.sh",
    "testCommand": "./test.sh"
  },
  "loop": {
    "iterationCap": 5,
    "severityBar": "medium",
    "turnTimeoutMs": 300000
  },
  "supplemental": {
    "coldHunt": false,
    "planner": false
  },
  "detectors": {
    "semgrep": {
      "enabled": true,
      "ruleset": ".semgrep/crossfire-c.yml",
      "timeBudgetMs": 120000
    },
    "osvScanner": {
      "enabled": true,
      "lockfiles": ["package-lock.json"],
      "timeBudgetMs": 60000
    },
    "fuzz": {
      "enabled": true,
      "timeBudgetMs": 300000,
      "harnesses": [
        {
          "id": "parse-request",
          "language": "c",
          "engine": "libfuzzer",
          "entryPoint": "build/parse-request-fuzzer",
          "corpusDir": "fuzz/corpus/parse-request"
        }
      ]
    }
  }
}
